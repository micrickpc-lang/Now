# This template intentionally contains no credentials, OTPs or cryptographic
# material. Copy it to a private `.env`/`.env.staging`, then generate every blank
# value independently. Never commit the populated file.

# Local application defaults
NODE_ENV=development
APP_ENV=development
PORT=3000
ADMIN_PORT=3001
DATABASE_URL=
DATABASE_MIGRATION_URL=
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
TOKEN_HASH_SECRET=
PHONE_HASH_SECRET=
LOCATION_MASTER_KEY_BASE64=
LOCATION_PRIVACY_SECRET=
ALLOW_EXACT_LOCATION=false
# Explicit auth modes: local_test is development-only; real_sms uses the HTTP
# provider values below. Keep OTPs and provider credentials in an untracked env file.
AUTH_MODE=local_test
ALLOW_LOCAL_TEST_OTP=false
LOCAL_TEST_OTP=
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TEMPLATE=Your login code is {code}
SMS_TIMEOUT_MS=10000
# Legacy staging/SMS.ru settings remain supported during migration.
ALLOW_DEV_OTP=false
DEV_OTP_CODE=
OTP_TTL_SECONDS=300
SMS_PROVIDER=development
SMS_RU_API_ID=
SMS_RU_FROM=
SMS_RU_TIMEOUT_MS=5000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_ORIGINS=http://localhost:3001,http://localhost:8080
TRUST_PROXY_HOPS=1
PUBLIC_API_URL=http://localhost:3000/api/v1
INTERNAL_MARTIN_URL=http://martin:3000
INTERNAL_NOMINATIM_URL=http://nominatim:8080
MAP_PUBLIC_BASE_URL=http://localhost:8080/api/v1/maps
MAP_UPSTREAM_TIMEOUT_MS=5000
MAP_GEOCODER_RETRY_DELAY_MS=1200
SEARCH_COUNTRY_CODES=mc
# self_hosted uses INTERNAL_NOMINATIM_URL. global_provider uses fixed,
# Nominatim-compatible HTTPS endpoints; mobile never receives GEOCODING_API_KEY.
MAP_MODE=self_hosted
GEOCODING_BASE_URL=
REVERSE_GEOCODING_BASE_URL=
GEOCODING_API_KEY=
GEOCODING_API_KEY_HEADER=
GEOCODING_API_KEY_QUERY_PARAM=key
MAP_GLOBAL_FALLBACK_TO_SELF_HOSTED=false
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=seychas-media
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_EMAIL=admin@local.invalid
ADMIN_BOOTSTRAP_PASSWORD=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ALLOW_UNSCANNED_UPLOADS=false

# Standalone bare-IP staging (`docker-compose.staging.yml`)
PUBLIC_IP=
LAN_IP=
STAGING_BIND_ADDRESS=0.0.0.0
NOW_DATA_ROOT=/opt/now/data
IMAGE_TAG=staging
POSTGRES_DB=seychas
POSTGRES_USER=seychas
POSTGRES_PASSWORD=
NOMINATIM_PASSWORD=
STAGING_TEST_PHONE_ALLOWLIST=
STAGING_TEST_OTP=
